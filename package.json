{
  "name": "zane-stick",
  "version": "0.1.0",
  "description": "Physics-only football hitting and tackling simulator",
  "scripts": {
    "dev": "vite",
    "dev:rooms": "npx --yes wrangler@4.151.0 dev -c server/rooms/wrangler.jsonc --ip 127.0.0.1 --port 8787",
    "deploy:cf": "npm run typecheck && npm test && npm run build && npx --yes wrangler@4.151.0 pages deploy dist --project-name zane-stick --branch main --commit-dirty=true",
    "deploy:rooms": "npm run typecheck && npx vitest run tests/net-room.test.ts && npx --yes wrangler@4.151.0 deploy -c server/rooms/wrangler.jsonc",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "test:e2e": "playwright test",
    "bench:engines": "tsx bench/engines/run.ts",
    "test:realism": "vitest run --config vitest.realism.config.ts",
    "sfx:build": "tsx tools/sfx/build.ts",
    "sfx:export": "tsx tools/sfx/export-picks.ts",
    "models:export": "tsx tools/models/export.ts",
    "picker": "vite --config tools/picker/vite.config.ts",
    "test:picker": "playwright test --config tools/picker/playwright.config.ts"
  },
  "license": "MIT",
  "type": "module",
  "devDependencies": {
    "@dimforge/rapier3d-compat": "^0.21.0",
    "@dimforge/rapier3d-deterministic-compat": "^0.21.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "@types/three": "^0.186.0",
    "jolt-physics": "^1.1.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@mujoco/mujoco": "^3.16.0",
    "three": "^0.186.1"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  },
  "private": true
}
